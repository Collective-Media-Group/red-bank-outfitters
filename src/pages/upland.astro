---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/upland-cover.jpg')\" role=\"img\" aria-label=\"Golden bunch grass and brush at the edge of a blue oak grove\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Upland</span></div>\n    <h1>Upland Game</h1>\n    <p class=\"lead\">A menu of California birds, walked up or driven, with dogs that live for it.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Species</div><div class=\"v\">7</div></div><div><div class=\"k\">Dogs</div><div class=\"v\">On site</div></div><div><div class=\"k\">Season</div><div class=\"v\">Inquire</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Red Bank was built as a quail club. Everything else on the ranch grew out of that.</p>\n<p>Bobwhite is the plantation walk-up: two guns, a guide, a brace of dogs, field edges and flats of head-height brush. Valley quail is a different animal \u2014 wild birds, a short California season from October through January, hunted Texas-style on 5,000 acres just north of the ranch, groups of up to four, out of utility vehicles. Mountain quail live in the chaparral a 30-minute drive west; you listen at daylight for a bird more often heard than seen.</p>\n<p>Pheasant comes two ways: a walk-up (minimum two shooters) and a European-style drive with pegs, beaters, and pickers-up, four to twelve guns, at least a hundred birds. Chukar run the steep banks. Rio Grande turkey has a fall season (tom or hen) and a spring season (bearded gobblers only), under California Fish and Wildlife rules.</p>\n<ul>\n<li><a href=\"/upland/bobwhite\">Southern-style bobwhite</a></li>\n<li><a href=\"/upland/valley-quail\">Valley quail</a></li>\n<li><a href=\"/upland/mountain-quail\">Mountain quail</a></li>\n<li><a href=\"/upland/chukar\">Chukar</a></li>\n<li><a href=\"/upland/pheasant\">Walk-up pheasant</a></li>\n<li><a href=\"/upland/european-drive\">European-style drive</a></li>\n<li><a href=\"/upland/turkey\">Wild turkey</a></li>\n</ul>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">2+1</div><div class=\"l mono\">Guns and a guide</div></div><div class=\"f\"><div class=\"n\">Oct\u2013Jan</div><div class=\"l mono\">Valley quail</div></div><div class=\"f\"><div class=\"n\">4\u201312</div><div class=\"l mono\">Drive guns</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="Upland Game \u2014 Red Bank Outfitters" description="Bobwhite, valley and mountain quail, chukar, pheasant, European-style drives, and Rio Grande turkey in Red Bluff, California." active="upland" inner={true}>
  <Fragment set:html={body} />
</Base>
