---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="News — Red Bank Outfitters" description="News and newsletters from Red Bank Outfitters, Red Bluff — season reports, films shot on the ranch, and the Around the Ranch archive." active="stay" inner={true}>
  <header class="page-hero">
    <div class="ph-bg" style="background-image:url('/img/ranch-gate.jpg')" role="img" aria-label="A timber ranch gate on a golden hillside at dusk"></div>
    <div class="page-hero-inner">
      <div class="crumb mono"><a href="/">Home</a><span>/</span><span>News</span></div>
      <h1>News</h1>
      <p class="lead">Season reports, films shot on the ranch, and the Around the Ranch newsletter archive. For this season's dates, get in touch.</p>
      <div class="ph-meta">
        <div><div class="k">Posts</div><div class="v">{posts.length}</div></div>
        <div><div class="k">Archive</div><div class="v">2012–2020</div></div>
        <div><div class="k">Now</div><div class="v">Inquire</div></div>
      </div>
    </div>
  </header>

  <div class="blog-grid">
    {posts.map((post) => (
      <a class="blog-card reveal" href={'/news/' + post.id}>
        <div class="bimg" style={`background-image:url('${post.data.hero}')`}></div>
        <div class="bbody">
          <div class="mono bdate">{fmt.format(post.data.date)}</div>
          <h3>{post.data.title}</h3>
          <p>{post.data.excerpt}</p>
          <span class="mono bmore">Read &rarr;</span>
        </div>
      </a>
    ))}
  </div>
</Base>
