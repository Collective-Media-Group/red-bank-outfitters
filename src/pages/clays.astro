---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/clays-station.jpg')\" role=\"img\" aria-label=\"A sporting clays stand under valley oaks on a Northern California ranch\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Clays</span></div>\n    <h1>Sporting Clays</h1>\n    <p class=\"lead\">Practice and competition over water, through brush, and under valley oaks. Loaner shotguns, ammunition, ear plugs, and shooting glasses on site.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Stations</div><div class=\"v\">18</div></div><div><div class=\"k\">Loaners</div><div class=\"v\">Yes</div></div><div><div class=\"k\">Safety</div><div class=\"v\">On site</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">An 18-station course. You will be shot at from every angle the oak country can invent.</p>\n<p>Targets run over water, through brush, and under valley oaks. Loaner shotguns and ammunition are available, plus ear plugs and shooting glasses.</p>\n<p>The photograph of a gun over a pond is from the ranch. Ask us about a clays-only afternoon, or add it between hunts.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">18</div><div class=\"l mono\">Stations</div></div><div class=\"f\"><div class=\"n\">Oaks</div><div class=\"l mono\">The course</div></div><div class=\"f\"><div class=\"n\">Loaners</div><div class=\"l mono\">Guns & shells</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/bass\"><div class=\"img\" style=\"background-image:url('/img/pond.jpg')\"></div><h3>Bass <em>ponds</em></h3><p>Eleven of them.</p></a><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/dogs-water.jpg')\"></div><h3>Then <em>birds</em></h3><p>Warm up the gun.</p></a><a class=\"rel\" href=\"/dining\"><div class=\"img\" style=\"background-image:url('/img/dining-room.jpg')\"></div><h3>Lunch <em>after</em></h3><p>Day shooters welcome.</p></a></div></div>\n";
---
<Base title="Sporting Clays \u2014 Red Bank Outfitters" description="18-station sporting clays course at Red Bank Outfitters, Red Bluff. Over water, through brush and valley oaks. Loaner shotguns and ammunition available." active="bass" inner={true}>
  <Fragment set:html={body} />
</Base>
