---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/dogs-water.jpg')\" role=\"img\" aria-label=\"A pointer and a Labrador in a ranch pond under oaks\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Kennels</span></div>\n    <h1>Kennels</h1>\n    <p class=\"lead\">Over 30 professionally trained bird dogs. Training, breeding, pointers. Kennels at both buildings. Your own dogs are welcome.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Dogs</div><div class=\"v\">30+</div></div><div><div class=\"k\">Buildings</div><div class=\"v\">2 kennels</div></div><div><div class=\"k\">Your dogs</div><div class=\"v\">Welcome</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">A brace of bird dogs on point is almost better than the shooting. Red Bank keeps the string to make that true.</p>\n<p>The kennel holds more than 30 professionally trained bird dogs. They offer training, breeding, and pointers for the hunt. There is a kennel at the lodge and at the bunkhouse. Bring your own dogs if you want \u2014 they have a place to sleep.</p>\n<p>The Outdoor Academy lists a 40-dog kennel on the same ranch. Call if you are looking for a pup or a week of training rather than a hunt.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">30+</div><div class=\"l mono\">Trained dogs</div></div><div class=\"f\"><div class=\"n\">2</div><div class=\"l mono\">Kennel buildings</div></div><div class=\"f\"><div class=\"n\">Yes</div><div class=\"l mono\">Your dogs</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="Kennels \u2014 Red Bank Outfitters" description="Over 30 professionally trained bird dogs at Red Bank Outfitters. Training, breeding, pointers, and kennels at both the lodge and bunkhouse." active="bass" inner={true}>
  <Fragment set:html={body} />
</Base>
