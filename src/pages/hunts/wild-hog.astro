---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/hog.jpg')\" role=\"img\" aria-label=\"A wild hog taken at Red Bank Outfitters\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/big-game\">Big Game</a><span>/</span><span>Wild hog</span></div>\n    <h1>Wild Hog</h1>\n    <p class=\"lead\">European wild boar, feral hogs, and crosses. Eighteen thousand acres from open oak hills to manzanita bedding cover.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Acres</div><div class=\"v\">18,000</div></div><div><div class=\"k\">Method</div><div class=\"v\">UTV or foot</div></div><div><div class=\"k\">Grove</div><div class=\"v\">Eucalyptus option</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">From California's north coast to the eastern Sierra, European wild boar, feral hogs, and crosses range the most populated state in the union. At Red Bank you hunt them on 18,000 acres.</p>\n<p>Open rolling hills dotted with oak. Deep draws of poison oak and manzanita \u2014 favorite bedding. Other ground is thicker studded oaks on flatter terrain. For the brave: a thousand-acre eucalyptus grove with dogs and an open-sight big-bore.</p>\n<p>You will spend time on a UTV. Awkward-looking animals, well-built, and not to be underestimated. Confirm current California rules when you book.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">18,000</div><div class=\"l mono\">Acres</div></div><div class=\"f\"><div class=\"n\">UTV</div><div class=\"l mono\">Standard</div></div><div class=\"f\"><div class=\"n\">Dogs</div><div class=\"l mono\">Grove option</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/hunts/blacktail\"><div class=\"img\" style=\"background-image:url('/img/deer.jpg')\"></div><h3>Blacktail</h3><p>Three-day hunts.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div><h3>Stay</h3><p>Lodge or bunkhouse.</p></a><a class=\"rel\" href=\"/gallery\"><div class=\"img\" style=\"background-image:url('/img/hog-record.jpg')\"></div><h3>440 lb</h3><p>Ranch record, 2011.</p></a></div></div>\n";
---
<Base title="Wild Hog \u2014 Red Bank Outfitters" description="Wild hog hunts on 18,000 acres at Red Bank Outfitters. Oaks, manzanita, poison oak draws, eucalyptus grove. UTV or on foot." active="big" inner={true}>
  <Fragment set:html={body} />
</Base>
