---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/deer.jpg')\" role=\"img\" aria-label=\"A blacktail buck taken at Red Bank\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/big-game\">Big Game</a><span>/</span><span>Blacktail</span></div>\n    <h1>Blacktail Deer</h1>\n    <p class=\"lead\">More than 10,000 acres of managed habitat. A healthy buck-to-doe ratio. Average 6 to 10 bucks a day. Guide, lodging, meals, field dressing included.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Acres</div><div class=\"v\">10,000+</div></div><div><div class=\"k\">Days</div><div class=\"v\">3</div></div><div><div class=\"k\">Bucks / day</div><div class=\"v\">6\u201310</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">We now offer over 10,000 acres of prime habitat for blacktail deer. The herd is managed closely through habitat work and the number of animals taken per year.</p>\n<p>On your hunt you will see an abundance of wildlife and average 6 to 10 bucks a day. The three-day hunt includes guide, lodging, meals, and field dressing ready for the butcher. Walk-in cold storage is on the ranch. They will prepare a trophy for the taxidermist and can assist with a local shop.</p>\n<p>Roger Sabette, after years of asking, became the first archery hunter Brian Riley permitted on a blacktail in 26 years of owning the ranch. Ric Gould guided him. Rifle season remains limited. Call.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">3</div><div class=\"l mono\">Days</div></div><div class=\"f\"><div class=\"n\">6\u201310</div><div class=\"l mono\">Bucks seen</div></div><div class=\"f\"><div class=\"n\">Incl.</div><div class=\"l mono\">Guide, bed, table</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/hunts/wild-hog\"><div class=\"img\" style=\"background-image:url('/img/hog.jpg')\"></div><h3>Wild <em>hog</em></h3><p>Same ranch, different animal.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>Lodge</h3><p>Part of the package.</p></a><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/dogs-water.jpg')\"></div><h3>Add <em>birds</em></h3><p>If dates allow.</p></a></div></div>\n";
---
<Base title="Blacktail Deer Hunts \u2014 Red Bank Outfitters" description="Columbia blacktail deer hunts at Red Bank Outfitters. 10,000+ acres, 6\u201310 bucks a day, 3-day all-inclusive: guide, lodging, meals, field dressing." active="big" inner={true}>
  <Fragment set:html={body} />
</Base>
