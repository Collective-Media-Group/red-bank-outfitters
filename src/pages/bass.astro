---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/pond.jpg')\" role=\"img\" aria-label=\"A still bass pond in Northern California oak hills at dusk\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Bass</span></div>\n    <h1>Bass Fishing</h1>\n    <p class=\"lead\">Fish between hunts. Osprey, golden eagles, deer, turkey, hogs, coyotes, migratory ducks and Canada geese use the same water.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Ponds</div><div class=\"v\">11</div></div><div><div class=\"k\">License</div><div class=\"v\">CA required</div></div><div><div class=\"k\">Package</div><div class=\"v\">Day + lodging</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Largemouth bass take the eleven ponds. One-day packages include lodging. Bring a California fishing license.</p>\n<p>The water is also a wildlife sit. Osprey and golden eagles. Upland birds, deer, wild turkeys, wild hogs, coyotes. Migratory ducks and Canada geese. Songbirds including the western kingbird and Lewis's woodpecker.</p>\n<p>Contact us for dates. A fishing day is often stacked with clays or an afternoon walk-up.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">11</div><div class=\"l mono\">Ponds</div></div><div class=\"f\"><div class=\"n\">1</div><div class=\"l mono\">Day packages</div></div><div class=\"f\"><div class=\"n\">CA</div><div class=\"l mono\">License</div></div></div>\n    <p class=\"gen-note\">Atmosphere photograph of Tehama County oak country \u2014 not a picture of a Red Bank hunt.</p>\n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/clays\"><div class=\"img\" style=\"background-image:url('/img/clays-station.jpg')\"></div><h3>Sporting <em>clays</em></h3><p>18 stations over water and through oaks.</p></a><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/dogs-water.jpg')\"></div><h3>Upland <em>game</em></h3><p>Birds the same week.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>Stay <em>over</em></h3><p>Lodge or bunkhouse.</p></a></div></div>\n";
---
<Base title="Bass Fishing \u2014 Red Bank Outfitters" description="Largemouth bass on 11 ponds at Red Bank Outfitters, Red Bluff. One-day packages include lodging. California fishing license required." active="bass" inner={true}>
  <Fragment set:html={body} />
</Base>
