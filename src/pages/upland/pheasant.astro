---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/pheasant.jpg')\" role=\"img\" aria-label=\"Pheasant hunt photograph from Red Bank\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/upland\">Upland</a><span>/</span><span>Pheasant</span></div>\n    <h1>Walk-Up Pheasant</h1>\n    <p class=\"lead\">Ring-necked pheasants that burst cover and make multiple flights. Their squawks startle a field. Two shooters minimum.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Min</div><div class=\"v\">2 shooters</div></div><div><div class=\"k\">Bird</div><div class=\"v\">Ring-neck</div></div><div><div class=\"k\">Style</div><div class=\"v\">Walk-up</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Walk-up pheasant, with a twist. Quality birds, lean fliers, multiple flights to safety.</p>\n<p>Minimum two shooters. For a bigger party and a different rhythm, see the <a href=\"/european-drive\">European-style drive</a>.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">2</div><div class=\"l mono\">Minimum guns</div></div><div class=\"f\"><div class=\"n\">Walk-up</div><div class=\"l mono\">The method</div></div><div class=\"f\"><div class=\"n\">Drive</div><div class=\"l mono\">Also offered</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 8–16. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="Walk-Up Pheasant \u2014 Red Bank Outfitters" description="Walk-up ring-necked pheasant hunts at Red Bank Outfitters. Minimum two shooters. Lean fliers that make multiple flights." active="upland" inner={true}>
  <Fragment set:html={body} />
</Base>
