---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/driven.jpg')\" role=\"img\" aria-label=\"Driven pheasant at Red Bank\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/upland\">Upland</a><span>/</span><span>Drive</span></div>\n    <h1>European-Style Drive</h1>\n    <p class=\"lead\">Four to twelve guns. Beaters push pheasants. Pickers-up work behind. After each push, rotate. At least 100 birds released.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Guns</div><div class=\"v\">4\u201312</div></div><div><div class=\"k\">Birds</div><div class=\"v\">100+</div></div><div><div class=\"k\">Style</div><div class=\"v\">Driven</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Imagine an English thicket: gentlemen at pegs, beaters pushing birds, pickers-up with retrievers behind the line. After each push, a pause, then rotate.</p>\n<p>A squad of 4 to 12 shooters works every station and every angle. At least 100 birds are released. Additional pheasants are available.</p>\n<p>On the old Sportsman's News film they drove birds off a bluff about a hundred feet up. Call if you want that shape of day.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">4\u201312</div><div class=\"l mono\">Shooters</div></div><div class=\"f\"><div class=\"n\">100+</div><div class=\"l mono\">Birds</div></div><div class=\"f\"><div class=\"n\">Pegs</div><div class=\"l mono\">Rotate</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="European-Style Drive \u2014 Red Bank Outfitters" description="European-style driven pheasant at Red Bank Outfitters. 4 to 12 shooters, pegs, beaters, pickers-up. At least 100 birds." active="upland" inner={true}>
  <Fragment set:html={body} />
</Base>
