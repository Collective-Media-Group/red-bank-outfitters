const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/dogs-water.jpg')\" role=\"img\" aria-label=\"Pointers working cover\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/upland\">Upland</a><span>/</span><span>Bobwhite</span></div>\n    <h1>Southern-Style Bob White Quail</h1>\n    <p class=\"lead\">Men and dogs on field edges and flats of head-height brush. Two guests, one guide, three or four dogs.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Party</div><div class=\"v\">2 + guide</div></div><div><div class=\"k\">Dogs</div><div class=\"v\">3\u20134</div></div><div><div class=\"k\">Groups</div><div class=\"v\">Not mixed</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Thoughts of Southern-style quail hunting invoke field edges and explosive bobwhites. Since 1965 that has been the point of this ranch.</p>\n<p>Red Bank does not mix groups. The lodge holds 14, the bunkhouse 6. No minimum party size.</p>\n<p>We hunt with two guests, one guide, and three or four dogs. The dogs are the heart of it. Your own dogs are welcome; there is a kennel at both buildings.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">2</div><div class=\"l mono\">Guests</div></div><div class=\"f\"><div class=\"n\">1</div><div class=\"l mono\">Guide</div></div><div class=\"f\"><div class=\"n\">3\u20134</div><div class=\"l mono\">Dogs</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
