---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/ranch-hills.jpg')\" role=\"img\" aria-label=\"Open ranch hills in Tehama County\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/upland\">Upland</a><span>/</span><span>Valley quail</span></div>\n    <h1>Valley Quail</h1>\n    <p class=\"lead\">A short California season, October through January. Demand is high. Groups of up to four, out of utility vehicles, on 5,000 acres just north of the ranch.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Season</div><div class=\"v\">Oct\u2013Jan</div></div><div><div class=\"k\">Acres</div><div class=\"v\">5,000</div></div><div><div class=\"k\">Party</div><div class=\"v\">Up to 4</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Native birds. A limited season under California law. This is a test of quickness.</p>\n<p>Valley quail are hunted on a 5,000-acre ranch just north of Red Bank. Groups of up to four ride utility vehicles to cover the ground. Call early. The window is short.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">Oct\u2013Jan</div><div class=\"l mono\">Season</div></div><div class=\"f\"><div class=\"n\">5,000</div><div class=\"l mono\">Acres</div></div><div class=\"f\"><div class=\"n\">4</div><div class=\"l mono\">Max in a group</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="Valley Quail \u2014 Red Bank Outfitters" description="Wild valley quail hunted Texas-style, October through January, on 5,000 acres north of Red Bank. Groups of up to four." active="upland" inner={true}>
  <Fragment set:html={body} />
</Base>
