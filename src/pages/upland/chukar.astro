---
import Base from '../../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/ranch-hills.jpg')\" role=\"img\" aria-label=\"Steep ranch ground\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><a href=\"/upland\">Upland</a><span>/</span><span>Chukar</span></div>\n    <h1>Chukar</h1>\n    <p class=\"lead\">A unique challenge: innate running ability, steep banks, a short flush, then a footrace.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Flush</div><div class=\"v\">Short</div></div><div><div class=\"k\">Then</div><div class=\"v\">They run</div></div><div><div class=\"k\">Ground</div><div class=\"v\">Steep</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Chukar partridge run. They climb a steep bank, flush a short distance, and try the quick-footed escape. That is the hunt.</p>\n<p>Stack it with bobwhite or pheasant in the same trip. Contact us and we will put the right day together.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">Short</div><div class=\"l mono\">Flush</div></div><div class=\"f\"><div class=\"n\">Steep</div><div class=\"l mono\">Banks</div></div><div class=\"f\"><div class=\"n\">Contact</div><div class=\"l mono\">For dates</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="Chukar \u2014 Red Bank Outfitters" description="Chukar partridge hunts at Red Bank Outfitters. Running birds on steep banks." active="upland" inner={true}>
  <Fragment set:html={body} />
</Base>
