---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"hero\">\n  <div class=\"hero-media\" style=\"background-image:url('/img/lodge-exterior.jpg')\"></div>\n  <div class=\"hero-grain\" aria-hidden=\"true\"></div>\n  <div class=\"hero-inner\">\n    <div class=\"hero-eyebrow\">\n      <span class=\"dash\"></span>\n      <span class=\"mono\">Opening Fall 2026 \u00b7 Accepting Reservations</span>\n    </div>\n    <h1>The Lodge</h1>\n    <p class=\"hero-sub\">\n      The newly built, state-of-the-art lodge on Red Bank Creek \u2014 6,500 square feet,\n      sleeping 8 to 16, one private party at a time.\n    </p>\n    <div class=\"hero-foot\">\n      <div class=\"hero-cta-row\">\n        <a class=\"btn-primary\" href=\"/contact\">Book Your Stay</a>\n        <a class=\"btn-ghost\" href=\"tel:+15305299435\">Call Us at (530) 529-9435</a>\n      </div>\n    </div>\n  </div>\n</header>\n\n<section class=\"about\">\n  <div class=\"sec\">\n    <div class=\"sec-head reveal\">\n      <div class=\"mono label\">01 \u2014 The House</div>\n      <h2>Newly built. <em>State of the art.</em> Still run the old way.</h2>\n    </div>\n    <div class=\"about-grid\">\n      <div class=\"about-copy reveal\">\n        <p>The Lodge is the main house of the ranch \u2014 built new, appointed for the evening after the hunt, and never shared. Sixty-five hundred square feet: a great room under a fireplace wall, the long table where the household staff serve supper, and bedrooms for eight to sixteen guests \u2014 every one with a private en-suite bath.</p>\n        <p>The two largest bedrooms take king beds, and for bigger parties we set up bunks in the great room. Groups are not mixed \u2014 the lodge is yours for the length of your stay, with kennels on site and the porch looking over the creek country.</p>\n        <div class=\"about-stats\">\n          <div class=\"stat\"><div class=\"num\" data-counter=\"6500\">0</div><div class=\"lbl mono\">Sq ft</div></div>\n          <div class=\"stat\"><div class=\"num\" data-counter=\"16\">0</div><div class=\"lbl mono\">Sleeps up to</div></div>\n          <div class=\"stat\"><div class=\"num\" data-counter=\"1\">0</div><div class=\"lbl mono\">Party at a time</div></div>\n        </div>\n      </div>\n      <div class=\"about-img reveal hide-mobile img-fade\">\n        <div class=\"ph\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div>\n        <div class=\"ph\" style=\"background-image:url('/img/table-supper.jpg')\"></div>\n        <div class=\"ph\" style=\"background-image:url('/img/lodge-landscape.jpg')\"></div>\n        <div class=\"ph\" style=\"background-image:url('/img/bedroom-parallax.jpg')\"></div>\n        <div class=\"cap\"><span class=\"d\"></span><span class=\"mono\">The new lodge</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"parallax-band parallax-fade pfade-mobile\" role=\"img\" aria-label=\"The lodge \u2014 pavilion, the table, the rooms, the great room\"><div class=\"pf\" style=\"background-image:url('/img/lodge-parallax.jpg')\"></div><div class=\"pf\" style=\"background-image:url('/img/table-parallax.jpg')\"></div><div class=\"pf\" style=\"background-image:url('/img/bedroom-parallax.jpg')\"></div><div class=\"pf\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div></div>\n\n<section class=\"house\">\n  <div class=\"house-inner\">\n    <div class=\"sec-head reveal\">\n      <div class=\"mono label\">02 \u2014 Experience</div>\n      <h2>Everything the evening needs <em>after the hunt.</em></h2>\n    </div>\n    <div class=\"house-grid\">\n      <div class=\"house-item\">\n        <span class=\"n mono\">01</span>\n        <h3>The great room</h3>\n        <p>A fireplace wall, deep sofas, and a big screen with satellite.</p>\n      </div>\n      <div class=\"house-item\">\n        <span class=\"n mono\">02</span>\n        <h3>The loft</h3>\n        <p>The game room upstairs \u2014 cards, the poker table, a nightcap.</p>\n      </div>\n      <div class=\"house-item\">\n        <span class=\"n mono\">03</span>\n        <h3>The kitchen</h3>\n        <p>A full kitchen and the long table. Meals prepared by the household staff.</p>\n      </div>\n      <div class=\"house-item\">\n        <span class=\"n mono\">04</span>\n        <h3>The practical</h3>\n        <p>Private en-suite baths in every room, wifi, a large porch, a barbecue, and kennels on site.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"parallax-band parallax-fade hide-mobile\" role=\"img\" aria-label=\"Evenings at the lodge \u2014 the table, the rooms, the great room\"><div class=\"pf\" style=\"background-image:url('/img/table-parallax.jpg')\"></div><div class=\"pf\" style=\"background-image:url('/img/bedroom-parallax.jpg')\"></div><div class=\"pf\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div></div>\n\n<section class=\"pursuits\">\n  <div class=\"pursuits-inner\">\n    <div class=\"sec-head reveal\">\n      <div class=\"mono label\">03 \u2014 The Hunt</div>\n      <h2>The private Southern-style quail hunting ranch. <em>Since 1965.</em></h2>\n      <p class=\"sec-sub\">The premier California hunting and outfitters destination \u2014 eighteen thousand acres on the banks of Red Bank Creek in Red Bluff, greater Northern California.</p>\n    </div>\n    <div class=\"hunt-ticker marquee\">\n      <div class=\"marquee-track\">\n        <div class=\"marquee-group\"><span class=\"tk\">Southern-Style Bobwhite Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Valley Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Mountain Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Chukar</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Walk-Up Pheasant</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">European-Style Drives</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Rio Grande Turkey</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Columbia Blacktail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Wild Hog</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Bass Fishing \u2014 Eleven Ponds</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Sporting Clays \u2014 Eighteen Stations</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Bird Dogs &amp; Kennels</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">The Lodge</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Dining at the Long Table</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Ranch Weddings</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Corporate Retreats</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span></div>\n        <div class=\"marquee-group\" aria-hidden=\"true\"><span class=\"tk\">Southern-Style Bobwhite Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Valley Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Mountain Quail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Chukar</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Walk-Up Pheasant</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">European-Style Drives</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Rio Grande Turkey</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Columbia Blacktail</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Wild Hog</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Bass Fishing \u2014 Eleven Ponds</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Sporting Clays \u2014 Eighteen Stations</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Bird Dogs &amp; Kennels</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">The Lodge</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Dining at the Long Table</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Ranch Weddings</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span><span class=\"tk\">Corporate Retreats</span><span class=\"dm\" aria-hidden=\"true\">&#9670;</span></div>\n      </div>\n    </div>\n    <div class=\"hunt-grid\">\n      <a class=\"hunt-card wide tilt\" href=\"/upland\">\n        <div class=\"bg\" style=\"background-image:url('/img/pointer.jpg')\"></div>\n        <div class=\"veil\"></div>\n        <div class=\"txt\">\n          <div class=\"k mono\">Upland</div>\n          <h3>The <em>birds</em></h3>\n          <p>Bobwhite walked up. A European drive. Wild valley quail north of the ranch. Mountain quail in the chaparral.</p>\n        </div>\n      </a>\n      <a class=\"hunt-card tilt\" href=\"/hunts/blacktail\">\n        <div class=\"bg\" style=\"background-image:url('/img/creek.jpg')\"></div>\n        <div class=\"veil\"></div>\n        <div class=\"txt\"><div class=\"k mono\">Big game</div><h3>Blacktail</h3><p>Three days. Guide, lodging, meals.</p></div>\n      </a>\n      <a class=\"hunt-card tilt\" href=\"/hunts/wild-hog\">\n        <div class=\"bg\" style=\"background-image:url('/img/ranch-hills.jpg')\"></div>\n        <div class=\"veil\"></div>\n        <div class=\"txt\"><div class=\"k mono\">Big game</div><h3>Wild hog</h3><p>Oaks, draws, manzanita.</p></div>\n      </a>\n      <a class=\"hunt-card tilt\" href=\"/bass\">\n        <div class=\"bg\" style=\"background-image:url('/img/pond.jpg')\"></div>\n        <div class=\"veil\"></div>\n        <div class=\"txt\"><div class=\"k mono\">Water</div><h3>Eleven ponds</h3></div>\n      </a>\n      <a class=\"hunt-card tilt\" href=\"/clays\">\n        <div class=\"bg\" style=\"background-image:url('/img/clays-station.jpg')\"></div>\n        <div class=\"veil\"></div>\n        <div class=\"txt\"><div class=\"k mono\">Clays</div><h3>Eighteen stations</h3></div>\n      </a>\n    </div>\n  </div>\n</section>\n\n<div class=\"parallax-band\" style=\"background-image:url('/img/lodge-landscape.jpg')\" role=\"img\" aria-label=\"The lodge in the landscape, west of Red Bluff\"></div>\n\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/bunkhouse\"><div class=\"img\" style=\"background-image:url('/img/bunkhouse-porch.jpg')\"></div><h3>The <em>Bunkhouse</em></h3><p>Sleeps six. Stone-column porch.</p></a><a class=\"rel\" href=\"/dining\"><div class=\"img\" style=\"background-image:url('/img/dining-room.jpg')\"></div><h3>The <em>Dining</em></h3><p>Household staff and California wine.</p></a><a class=\"rel\" href=\"/weddings\"><div class=\"img\" style=\"background-image:url('/img/wedding-long-shot-alter-01.jpg')\"></div><h3>Weddings</h3><p>2,200 sq ft covered patio on the creek.</p></a></div></div>\n\n<section class=\"cta\">\n  <div class=\"cta-bg\"></div>\n  <div class=\"cta-inner\">\n    <h2 class=\"reveal\">The lodge is yours. <em>Book your stay.</em></h2>\n    <div class=\"cta-side reveal\">\n      <p>Reservations for the 26\u201327 season are open now. Contact us for dates and pricing, and we will take care of the rest.</p>\n      <div style=\"display:flex;gap:12px;flex-wrap:wrap\">\n        <a class=\"btn-primary\" href=\"/contact\">Book Your Stay</a>\n        <a class=\"btn-ghost\" href=\"tel:+15305299435\">(530) 529-9435</a>\n      </div>\n    </div>\n  </div>\n</section>\n";
---
<Base title="The Lodge at Red Bank Ale & Quail Outfitters" description="The newly built, state-of-the-art lodge at Red Bank Outfitters, Red Bluff \u2014 opening fall 2026 and accepting reservations. 6,500 square feet, sleeping 8 to 16 with private en-suite baths throughout. One party at a time." active="stay" inner={false} ogImage="/img/og/lodge-og.gif">
  <Fragment set:html={body} />
</Base>
