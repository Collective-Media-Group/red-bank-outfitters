---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/deer.jpg')\" role=\"img\" aria-label=\"A Columbia blacktail buck taken at Red Bank\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Big Game</span></div>\n    <h1>Big Game</h1>\n    <p class=\"lead\">A managed blacktail herd on more than 10,000 acres, and wild hog on the whole ranch.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Deer</div><div class=\"v\">3-day</div></div><div><div class=\"k\">Hog</div><div class=\"v\">Year-round*</div></div><div><div class=\"k\">Cold storage</div><div class=\"v\">Walk-in</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Columbia blacktail on a ranch they manage for a healthy buck-to-doe ratio. Wild hog from rolling oaks to manzanita draws to a eucalyptus grove if you want it close.</p>\n<p>The blacktail hunt is three days, all inclusive: guide, lodging, meals, and field dressing ready for the butcher. Walk-in cold storage is on the ranch. They will prepare a trophy for the taxidermist and can put you with a local shop. On a typical hunt you will see a lot of wildlife and average 6 to 10 bucks a day.</p>\n<p>Hogs are the other California staple here. From open oak hills to poison oak and manzanita bedding cover, then thicker studded oaks on flatter ground. For the brave, a thousand-acre eucalyptus grove with dogs and an open-sight big-bore.</p>\n<ul>\n<li><a href=\"/hunts/blacktail\">Blacktail deer hunts</a></li>\n<li><a href=\"/hunts/wild-hog\">Wild hog</a></li>\n</ul>\n<p style=\"font-size:13px;color:var(--ash)\">*Confirm current California seasons and tags when you call. Blacktail is a limited hunt.</p>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">10,000+</div><div class=\"l mono\">Deer acres</div></div><div class=\"f\"><div class=\"n\">6\u201310</div><div class=\"l mono\">Bucks seen / day</div></div><div class=\"f\"><div class=\"n\">3</div><div class=\"l mono\">Days, all-in</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/hunts/blacktail\"><div class=\"img\" style=\"background-image:url('/img/deer.jpg')\"></div><h3>Blacktail <em>deer</em></h3><p>Three days. Guide, lodge, meals, field dressing.</p></a><a class=\"rel\" href=\"/hunts/wild-hog\"><div class=\"img\" style=\"background-image:url('/img/hog.jpg')\"></div><h3>Wild <em>hog</em></h3><p>Oaks, draws, manzanita. UTV or on foot.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14.</p></a></div></div>\n";
---
<Base title="Big Game \u2014 Red Bank Outfitters" description="Blacktail deer and wild hog hunts on 18,000 acres west of Red Bluff, California." active="big" inner={true}>
  <Fragment set:html={body} />
</Base>
