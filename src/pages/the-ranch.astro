---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/creek.jpg')\" role=\"img\" aria-label=\"Red earth bluffs over a Northern California creek in oak country\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>The Ranch</span></div>\n    <h1>The Ranch</h1>\n    <p class=\"lead\">West of Red Bluff in Tehama County. One of the oldest hunting clubs in California, opened to an exclusive clientele in 1965.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Founded</div><div class=\"v\">1965</div></div><div><div class=\"k\">Acres</div><div class=\"v\">18,000</div></div><div><div class=\"k\">County</div><div class=\"v\">Tehama</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">Formerly Red Bank Ale &amp; Quail Game Bird Club. Brian Riley, who started here as a teenager just out of high school, bought the hunting operation with his wife Shellie. They expanded the original 5,000-acre ranch by acquiring rights to close to 11,000 more.</p>\n<p>The ranch sits six miles from town. From Interstate 5 take exit 647, west on Luther, left on Paskenta, right on Live Oak. Live Oak becomes Red Bank. The gate is on the left.</p>\n<p>Today the focus is quail habitat, the lodge and facilities, and the farming that keeps the place working. Between hunts: eleven bass and bluegill ponds, an 18-station sporting clays course, a 40-dog kennel at the academy, a wild-game processing room, and a 4,000-square-foot covered patio in front of the lodge.</p>\n<p>The ranch has hosted hunters including astronauts, Hollywood figures, and sports celebrities, and it runs corporate events. Summer camps are a separate operation: Red Bank Outdoor Academy, on the same land.</p>\n<h2>What sits behind the gate</h2>\n<ul>\n<li>Upland \u2014 bobwhite, valley, mountain and Gambel's quail, chukar, pheasant, Rio Grande turkey</li>\n<li>Big game \u2014 Columbia blacktail deer and wild hog</li>\n<li>Eleven bass ponds, osprey and golden eagles overhead</li>\n<li>18-station clays through oaks and over water</li>\n<li>Lodge for 14, bunkhouse for 6, kennels at both buildings</li>\n</ul>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">18,000</div><div class=\"l mono\">Acres</div></div><div class=\"f\"><div class=\"n\">11</div><div class=\"l mono\">Bass ponds</div></div><div class=\"f\"><div class=\"n\">6 mi</div><div class=\"l mono\">From town</div></div></div>\n    <p class=\"gen-note\">Atmosphere photograph of Tehama County oak country \u2014 not a picture of a Red Bank hunt.</p>\n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/upland\"><div class=\"img\" style=\"background-image:url('/img/pointer.jpg')\"></div><h3>Upland <em>birds</em></h3><p>Bobwhite, valley and mountain quail, pheasant, chukar, turkey.</p></a><a class=\"rel\" href=\"/hunts\"><div class=\"img\" style=\"background-image:url('/img/creek.jpg')\"></div><h3>The <em>hunt</em></h3><p>Two guns, one guide, three or four dogs.</p></a><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 14. Fireplace, kitchen, porch, kennel on site.</p></a></div></div>\n";
---
<Base title="The Ranch \u2014 Red Bank Outfitters" description="18,000 acres on Red Bank Creek west of Red Bluff. Founded in 1965 as Red Bank Ale & Quail." active="stay" inner={true}>
  <Fragment set:html={body} />
</Base>
