---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found — Red Bank Outfitters" description="There is no page at this address. Head back to the ranch — Red Bank Outfitters, Red Bluff, California." active="" inner={true}>
  <header class="page-hero" style="min-height:82vh;display:flex;align-items:center">
    <div class="ph-bg" style="background-image:url('/img/ranch-gate.jpg')" role="img" aria-label="A timber ranch gate on a golden hillside at dusk"></div>
    <div class="page-hero-inner">
      <div class="crumb mono"><a href="/">Home</a><span>/</span><span>404</span></div>
      <h1>Wrong gate.</h1>
      <p class="lead">There is no page at this address — but the ranch is just up the road. Eighteen thousand acres, and this is the one spot with nothing on it.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px">
        <a class="btn-primary" href="/">Back to the Ranch</a>
        <a class="btn-ghost" href="/contact" style="justify-content:center">Book a Hunt</a>
      </div>
    </div>
  </header>
</Base>
