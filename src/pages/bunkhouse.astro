---
import Base from '../layouts/Base.astro';
const body = "\n<header class=\"page-hero\">\n  <div class=\"ph-bg\" style=\"background-image:url('/img/bunkhouse-porch.jpg')\" role=\"img\" aria-label=\"Covered porch of the Red Bank bunkhouse with river-stone columns\"></div>\n  <div class=\"page-hero-inner\">\n    <div class=\"crumb mono\"><a href=\"/\">Home</a><span>/</span><span>Bunkhouse</span></div>\n    <h1>The Bunkhouse</h1>\n    <p class=\"lead\">After meals in the Grand Lodge, retire here. Satellite, a kitchen, a kennel, a barbecue, wifi.</p>\n    <div class=\"ph-meta\"><div><div class=\"k\">Sleeps</div><div class=\"v\">6</div></div><div><div class=\"k\">Kitchen</div><div class=\"v\">Full</div></div><div><div class=\"k\">Kennel</div><div class=\"v\">Yes</div></div></div>\n  </div>\n</header>\n<div class=\"page-body\">\n  <article class=\"prose\">\n    <p class=\"deck\">A ranch bunkhouse with river-stone columns on the porch. Six beds. The sign over the patio says Bunkhouse because that is what it is.</p>\n<p>Inside: satellite television, a full kitchen, a dog kennel, a barbecue, wifi. The hunt page allows 6\u20138; the bunkhouse page itself lists six. Call if your party is on the line.</p>\n<p>Use it with the lodge for a larger group, or take it as the quieter house.</p>\n<ul>\n<li>Sleeps up to six</li>\n<li>Satellite TV, full kitchen, wifi</li>\n<li>Dog kennel and barbecue</li>\n</ul>\n    <div class=\"facts\"><div class=\"f\"><div class=\"n\">6</div><div class=\"l mono\">Beds</div></div><div class=\"f\"><div class=\"n\">Stone</div><div class=\"l mono\">Porch columns</div></div><div class=\"f\"><div class=\"n\">Kennel</div><div class=\"l mono\">On site</div></div></div>\n    \n  </article>\n  <aside class=\"aside\">\n      <h3>Booking and Reservations</h3>\n      <p>Contact us for reservations and pricing. Groups are never mixed, and there is no minimum party size.</p>\n      <div class=\"row\"><span>Phone</span><b><a href=\"tel:+15305299435\">(530) 529-9435</a></b></div><div class=\"row\"><span>Email</span><b><a href=\"mailto:Hunting@RedBankOutfitters.com\">Hunting@RedBankOutfitters.com</a></b></div><div class=\"row\"><span>Address</span><b>18875 Red Bank Rd.<br>Red Bluff, CA 96080</b></div>\n      <a class=\"btn-primary\" href=\"tel:+15305299435\" style=\"margin-top:20px;width:100%;text-align:center\">Call Us at (530) 529-9435</a>\n      <a class=\"btn-ghost\" href=\"mailto:Hunting@RedBankOutfitters.com\" style=\"margin-top:10px;width:100%;text-align:center;justify-content:center\">Send message</a>\n    </aside>\n</div>\n<div class=\"related\"><h2>Also on the ranch</h2><div class=\"rel-grid\"><a class=\"rel\" href=\"/lodge\"><div class=\"img\" style=\"background-image:url('/img/lodge-wide.jpg')\"></div><h3>The <em>Lodge</em></h3><p>Sleeps 8–16.</p></a><a class=\"rel\" href=\"/dining\"><div class=\"img\" style=\"background-image:url('/img/dining-room.jpg')\"></div><h3>Dining</h3><p>Meals in the main house.</p></a><a class=\"rel\" href=\"/kennels\"><div class=\"img\" style=\"background-image:url('/img/dogs-water.jpg')\"></div><h3>Dogs</h3><p>Kennel here too.</p></a></div></div>\n";
---
<Base title="The Bunkhouse \u2014 Red Bank Outfitters" description="Deluxe bunkhouse at Red Bank Outfitters sleeps 6. Full kitchen, satellite TV, dog kennel, barbecue, wifi. Red Bluff, California." active="stay" inner={true}>
  <Fragment set:html={body} />
</Base>
